# DemoVox needs no secrets at build or run time.
# Visitors enter their own Anthropic and ElevenLabs keys in the browser.

# Optional: Remotion license key for client-side rendering.
# Leave empty if you qualify for Remotion's Free License (https://remotion.dev/license).
# This value is public: it is embedded in the browser bundle.
NEXT_PUBLIC_REMOTION_LICENSE_KEY=
